# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
# Public base URL of this API, used for uploaded image links (e.g. https://api.globalshelfbd.com)
PUBLIC_API_URL="http://localhost:5000"

# Database Configuration (PostgreSQL, e.g. Neon)
# Pooled connection used by the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection used by prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your_jwt_access_secret_key"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key"
JWT_RESET_SECRET="your_jwt_reset_secret_key"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Email / SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Global Shelf BD <your_email@gmail.com>

# Default Admin Credentials
ADMIN_EMAIL=admin@globalshelfbd.com
ADMIN_PASSWORD=Admin@12345
